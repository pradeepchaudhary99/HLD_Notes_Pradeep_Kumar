    {
      "id": "LoFESCwWxeuf9L2aXgScy",
      "type": "text",
      "x": 162331.88143116978,
      "y": 160102.6353047368,
      "width": 611.6317138671875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8i",
      "roundness": null,
      "seed": 945597704,
      "version": 352,
      "versionNonce": 62400520,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786882343307,
      "link": null,
      "locked": false,
      "text": "1. search for the movie\n2. select the cinema hall\n3. select the time slot\n4. select the seats\n5. make the payment\n6. booking confirmed\n7. get a QR + Email + SMS as a notification \n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. search for the movie\n2. select the cinema hall\n3. select the time slot\n4. select the seats\n5. make the payment\n6. booking confirmed\n7. get a QR + Email + SMS as a notification \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ly4Qm3JO0RkBnXUKibAO3",
      "type": "text",
      "x": 161853.46417149142,
      "y": 160435.4317967426,
      "width": 1041.879638671875,
      "height": 1365,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8j",
      "roundness": null,
      "seed": 1606058616,
      "version": 1311,
      "versionNonce": 682633224,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786885239023,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n    -  Search/browse movies by city/date/venue\n    -  view the seatMap per movie/hall/auditorium\n    -  hold selected seats for a short checkout period\n    - pay and receive the confirmed booking\n    - cancel the booking\n    - notify users(confirmation, reminder, cancellation)\n    - Admin: publish shows, configure venues & pricing\n\n\nNon-Functional Requirments:\n    - No-double booking of a seats\n    - no-double payment\n    - low latency search\n    - fast search for the movies\n    - High Availability \n    - Durability. --> once a booking is confirmed the entry should not be lost\n    - Fairness\n\n\n\nStep 3: API design & Core Entities\n     \nGET /events?city=blr&date=2026-08-15&q=inception\n\nGET /events/{eventId}\n\nGET /events/shows/{showId}/seatmap\n\nGet /bookings \n\nGet /bookings{booking_id}\n\n\n\n\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n    -  Search/browse movies by city/date/venue\n    -  view the seatMap per movie/hall/auditorium\n    -  hold selected seats for a short checkout period\n    - pay and receive the confirmed booking\n    - cancel the booking\n    - notify users(confirmation, reminder, cancellation)\n    - Admin: publish shows, configure venues & pricing\n\n\nNon-Functional Requirments:\n    - No-double booking of a seats\n    - no-double payment\n    - low latency search\n    - fast search for the movies\n    - High Availability \n    - Durability. --> once a booking is confirmed the entry should not be lost\n    - Fairness\n\n\n\nStep 3: API design & Core Entities\n     \nGET /events?city=blr&date=2026-08-15&q=inception\n\nGET /events/{eventId}\n\nGET /events/shows/{showId}/seatmap\n\nGet /bookings \n\nGet /bookings{booking_id}\n\n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
